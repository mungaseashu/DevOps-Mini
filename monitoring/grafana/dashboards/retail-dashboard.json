{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Sneaker Platform Health & Real-Time Sales Telemetry",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Platform Availability (K8s Health Probe)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "up{job=\"online-retail-app\"}",
          "legendFormat": "Status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "HEALTHY (UP)", "color": "green" }, "0": { "text": "OUTAGE (ALERT)", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Sneakers Sold (Confirmed Orders)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sneaker_orders_total",
          "legendFormat": "Sneakers Sold",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      }
    },
    {
      "id": 3,
      "title": "Sneaker Sales Revenue (USD)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sneaker_revenue_usd",
          "legendFormat": "Revenue",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      }
    },
    {
      "id": 4,
      "title": "Sneaker Drop Queue (Active Shoppers)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sneaker_drop_waitlist_active",
          "legendFormat": "Shoppers in Queue",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Drop Traffic Throughput & Checkout Latency",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Traffic Throughput (Requests / Sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"online-retail-app\"}[30s]))",
          "legendFormat": "Throughput (RPS)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "gradientMode": "opacity", "lineWidth": 2 },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "title": "Checkout Response Time & Latency (SLA Threshold 500ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "expr": "http_server_requests_seconds_max{application=\"online-retail-app\"} * 1000",
          "legendFormat": "Max Latency (ms)",
          "refId": "A"
        },
        {
          "expr": "(rate(http_server_requests_seconds_sum{application=\"online-retail-app\"}[1m]) / rate(http_server_requests_seconds_count{application=\"online-retail-app\"}[1m])) * 1000",
          "legendFormat": "Mean Latency (ms)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "Cluster Resource Utilization (CPU & JVM Memory)",
      "type": "row"
    },
    {
      "id": 7,
      "title": "CPU Usage (Process vs Host System)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "process_cpu_usage * 100",
          "legendFormat": "Sneaker App CPU (%)",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage * 100",
          "legendFormat": "Host System CPU (%)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 8,
      "title": "JVM Heap Memory Allocation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "Heap Memory Used",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "Heap Memory Max Limit",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["sneakers", "devops", "kubernetes", "sre", "reliability"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "CloudKicks - Shoe Retail Reliability Dashboard",
  "uid": "retail-reliability-dash",
  "version": 2
}
